# ── Agent 工作目录：不纳入版本控制 ──
.agent/

# ── Gradle ──
.gradle/
build/
out/
!gradle/wrapper/gradle-wrapper.jar

# ── Loom / Minecraft run 目录 ──
run/
runs/
.loom-cache/

# ── 原生库构建中间产物 ──
natives/build/
natives/**/*.obj
natives/**/*.pdb
natives/**/*.ilk
natives/**/*.exp
natives/**/*.lib

# premake 生成的 VS 工程：可随时用 premake5 重新生成，不入库
natives/vendor/ocgcore/build/

# 链接器默认会把导入库/导出文件写到当前工作目录；渲染兜底，
# 防止构建时又在仓库根留下 *.exp / *.lib
/*.exp
/*.lib
/*.obj
/*.dll
/*.pdb

# ── IDE ──
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
.eclipse/
bin/

# ── JVM 崩溃日志 ──
# 调原生库时经常要强杀被 fork 出来的游戏进程，JVM 会往工作目录丢 hs_err_pid*.log。
# 这些是诊断线索，但属于一次性的本地产物，不入库。
hs_err_pid*.log
replay_pid*.log

# ── 操作系统 ──
Thumbs.db
Desktop.ini
.DS_Store

# ── 本地数据（cdb / 脚本 / 卡图缓存的拷贝，禁止入库） ──
local-data/
*.cdb
